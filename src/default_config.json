{
  "optimization": {
    "n_calls": 20,
    "n_initial_points": 5,
    "random_state": 42,
    "verbose": true,
    "optimizer": "genetic",
    "use_cache": true,
    "cache_file": "optimization_cache.pkl",
    "early_stopping": true,
    "patience": 5,
    "min_delta": 0.01,
    "sensitivity_analysis": true,
    "sensitivity_trials": 5,
    "noise_level": 0.1,
    "n_jobs": 1,
    "adaptive_early_stopping": false,
    "convergence_threshold": 1e-06,
    "max_stagnation_iterations": 10
  },
  "ansa": {
    "ansa_executable": "ansa",
    "script_dir": "src",
    "input_model_path": "/absolute/path/to/input_model.ansa",
    "output_dir": "output",
    "criteria_dir": "/absolute/path/to/criteria",
    "mpar_file_pattern": "*.ansa_mpar",
    "qual_file_pattern": "*.ansa_qual",
    "batch_script": "batch_mesh.py",
    "execution_timeout": 300,
    "max_retries": 3,
    "retry_delay": 1.0,
    "min_element_length": 2.0,
    "max_element_length": 8.0,
    "quality_check_enabled": true,
    "max_memory_usage": 8.0,
    "temp_cleanup": true
  },
  "logging": {
    "level": "INFO",
    "console": {
      "enabled": true,
      "level": "INFO",
      "format": "simple"
    },
    "file": {
      "enabled": false,
      "level": "DEBUG",
      "format": "detailed",
      "filename": "ansa_optimizer.log",
      "max_size": "10MB",
      "backup_count": 5,
      "rotation": true
    },
    "modules": {
      "src.optimizers": "INFO",
      "src.evaluators": "INFO",
      "src.utils": "WARNING",
      "src.visualization": "WARNING",
      "src.cli": "INFO",
      "src.core": "INFO"
    }
  },
  "parameters": {
    "element_size": {
      "param_type": "float",
      "bounds": [
        0.5,
        2.0
      ],
      "description": "目标单元尺寸",
      "unit": "mm",
      "ansa_mapping": "target_element_length",
      "default_value": 1.0
    },
    "perimeter_length": {
      "param_type": "float",
      "bounds": [
        0.5,
        8.0
      ],
      "description": "周边长度",
      "unit": "mm",
      "ansa_mapping": "perimeter_length",
      "default_value": 2.0
    },
    "min_target_length": {
      "param_type": "float",
      "bounds": [
        1.0,
        2.0
      ],
      "description": "最小目标长度",
      "unit": "mm",
      "ansa_mapping": "general_min_target_len",
      "default_value": 1.5
    },
    "max_target_length": {
      "param_type": "float",
      "bounds": [
        8.0,
        10.0
      ],
      "description": "最大目标长度",
      "unit": "mm",
      "ansa_mapping": "general_max_target_len",
      "default_value": 9.0
    },
    "distortion_distance": {
      "param_type": "float",
      "bounds": [
        10.0,
        30.0
      ],
      "description": "扭曲距离",
      "unit": "%",
      "ansa_mapping": "distortion-distance",
      "default_value": 20.0
    },
    "rule_fillet_width_1": {
      "param_type": "float",
      "bounds": [
        1.0,
        5.0
      ],
      "description": "Fillet规则1的width上限值",
      "unit": "mm",
      "ansa_mapping": "rule_fillet_width_1",
      "default_value": 3.0
    },
    "rule_fillet_width_2": {
      "param_type": "float",
      "bounds": [
        5.0,
        12.0
      ],
      "description": "Fillet规则2的width上限值",
      "unit": "mm",
      "ansa_mapping": "rule_fillet_width_2",
      "default_value": 10.0
    },
    "rule_fillet_width_3": {
      "param_type": "float",
      "bounds": [
        12.0,
        25.0
      ],
      "description": "Fillet规则3的width上限值",
      "unit": "mm",
      "ansa_mapping": "rule_fillet_width_3",
      "default_value": 20.0
    },
    "rule_fillet_width_4": {
      "param_type": "float",
      "bounds": [
        25.0,
        40.0
      ],
      "description": "Fillet规则4的width上限值",
      "unit": "mm",
      "ansa_mapping": "rule_fillet_width_4",
      "default_value": 30.0
    },
    "recognize_chamfers_min_angle": {
      "param_type": "float",
      "bounds": [
        10.0,
        30.0
      ],
      "description": "Chamfer识别的最小角度",
      "unit": "degrees",
      "ansa_mapping": "recognize_chamfers_min_angle",
      "default_value": 20.0
    },
    "recognize_chamfers_max_angle": {
      "param_type": "float",
      "bounds": [
        60.0,
        80.0
      ],
      "description": "Chamfer识别的最大角度",
      "unit": "degrees",
      "ansa_mapping": "recognize_chamfers_max_angle",
      "default_value": 70.0
    },
    "recognize_chamfers_max_width": {
      "param_type": "float",
      "bounds": [
        10.0,
        30.0
      ],
      "description": "Chamfer识别的最大宽度",
      "unit": "mm",
      "ansa_mapping": "recognize_chamfers_max_width",
      "default_value": 20.0
    },
    "rule_chamfer_width_1": {
      "param_type": "float",
      "bounds": [
        5.0,
        20.0
      ],
      "description": "Chamfer规则的width上限值",
      "unit": "mm",
      "ansa_mapping": "rule_chamfer_width_1",
      "default_value": 10.0
    },
    "distortion_angle": {
      "param_type": "float",
      "bounds": [
        0.0,
        45.0
      ],
      "description": "扭曲角度参数",
      "unit": "degrees",
      "ansa_mapping": "distortion-angle",
      "default_value": 0.0
    },
    "perimeter_distance": {
      "param_type": "float",
      "bounds": [
        0.667,
        1.0
      ],
      "description": "周边距离系数",
      "unit": "*Lmin",
      "ansa_mapping": "remove_perimeters_with_distance",
      "default_value": 0.667
    }
  },
  "metadata": {
    "version": "2.0.0",
    "created_by": "ConsolidatedConfigManager",
    "description": "Consolidated Ansa mesh optimizer configuration file"
  }
}